# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# App
SECRET_KEY=replace-this-with-a-random-32-char-string
ENVIRONMENT=development
DEBUG=true

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://clinicflow:clinicflow@localhost:5432/clinicflow

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...

# Sentry (leave blank to disable)
SENTRY_DSN=

# S3 / MinIO (local dev — MinIO runs via docker-compose)
S3_BUCKET=clinicflow
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
